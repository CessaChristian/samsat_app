# Konfigurasi frontend. Salin menjadi frontend/.env lalu sesuaikan.
# Hanya berisi alamat, tidak ada rahasia: berkas ini dibaca saat build
# dan nilainya bisa terlihat di peramban.

# Porta Vite dev server.
VITE_PORT=5173

# Alamat backend Flask yang dituju proxy /api.
# Sengaja 127.0.0.1, bukan "localhost": di macOS "localhost" lebih dulu
# diarahkan ke ::1, dan porta 5000 di sana dijawab AirPlay Receiver bawaan
# sistem sehingga proxy membalas 403.
VITE_API_TARGET=http://127.0.0.1:5000
