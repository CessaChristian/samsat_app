# Konfigurasi backend. Salin menjadi backend/.env lalu sesuaikan.
# Berkas .env tidak pernah di-commit.

# --- Database ---
# Koneksi PostgreSQL 16.
DATABASE_URL=postgresql://<pengguna>@localhost:5432/samsat_app

# --- Sesi ---
# Kunci penanda tangan cookie sesi. Wajib diganti.
# Bangkitkan dengan: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-nilai-acak-panjang

# Aktifkan hanya bila aplikasi dilayani lewat HTTPS. Bila diaktifkan saat
# pengembangan di http://localhost, cookie tidak akan pernah terkirim.
SESSION_COOKIE_SECURE=false

# --- Server pengembangan (python3 main.py) ---
HOST=127.0.0.1
PORT=5000
# Muat ulang otomatis saat berkas berubah. Jangan diaktifkan di produksi.
DEBUG=true

# --- Tampilan ---
# Hasil "npm run build" yang disajikan Flask di akar situs, sehingga
# 'python3 main.py' saja sudah melayani tampilan dan API sekaligus.
# Lintasan relatif dihitung dari folder backend/.
FOLDER_FRONTEND=../frontend/dist

# --- Unggahan ---
# Folder berkas sementara antara "Cek File" dan "Simpan".
# Lintasan relatif dihitung dari folder backend/.
UPLOAD_TMP_DIR=./uploads_tmp

