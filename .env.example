# Salin ke .env lalu sesuaikan. Berkas .env tidak pernah di-commit.

# Koneksi PostgreSQL 16.
DATABASE_URL=postgresql://<pengguna>@localhost:5432/pkb_dashboard

# Kunci penanda tangan session cookie. Wajib diganti.
# Bangkitkan dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-nilai-acak-panjang

# Folder berkas unggahan sementara (antara Cek File dan Simpan).
UPLOAD_TMP_DIR=./uploads_tmp

# Kosongkan untuk memakai tanggal hari ini yang sebenarnya.
# Isi YYYY-MM-DD hanya untuk pengujian, misal APP_TODAY=2026-09-19
APP_TODAY=
